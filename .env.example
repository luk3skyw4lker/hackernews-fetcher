# Copy to .env; docker compose and `make run` pick these up.

# Host ports
PORT=8080
POSTGRES_PORT=5432

# Used by `make run` / local CLI (compose sets its own internal URL)
DATABASE_URL=postgres://hn:hn@localhost:5432/hn?sslmode=disable
DB_MAX_CONNS=10
DB_AUTO_MIGRATE=true
DB_AUTO_SEED=false

# HackerNews
HN_BASE_URL=https://hacker-news.firebaseio.com/v0
HN_MAX_CONCURRENCY=32
HN_REQUEST_TIMEOUT=5s
HN_MAX_RETRIES=3

# Crawl
TOP_STORIES=5
TOP_STORIES_INCLUDE_JOBS=false
CRAWL_TIMEOUT=60s
MAX_DEPTH=0

# Background refresh & retention
REFRESH_INTERVAL=5m
REFRESH_ENABLED=true
SNAPSHOT_RETENTION_COUNT=288
SNAPSHOT_RETENTION_AGE=168h

LOG_LEVEL=info
